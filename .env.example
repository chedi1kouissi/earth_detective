# Copy this file to .env and fill in the values. Never commit .env.

# Gemini (reasoning model for the curator and investigator agents)
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GEMINI_API_KEY=
# Optional: force a model, e.g. gemini-2.5-pro. Empty = automatic choice.
GEMINI_MODEL=

# Neo4j (local, e.g. Neo4j Desktop)
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Earthdata Login (https://urs.earthdata.nasa.gov) - needed only to download NASA data.
# Also approve "NASA GESDISC DATA ARCHIVE" under Applications > Authorized Apps.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
